<?xml version="1.0"?>
<launch>
  <!-- DYNAMIXEL XL330-M288-T Controller Launch File -->
  <!-- Supports both keyboard teleop and person tracking modes -->
  
  <!-- Launch Arguments -->
  <!-- Mode selection: keyboard | tracking -->
  <arg name="mode" default="keyboard" doc="Control mode: keyboard for manual control, tracking for person following"/>
  
  <!-- Device configuration -->
  <arg name="device_name" default="/dev/ttyUSB0" doc="DYNAMIXEL device port"/>
  <arg name="baudrate" default="57600" doc="Communication baudrate"/>
  
  <!-- Common DYNAMIXEL parameters -->
  <arg name="motor_id" default="1" doc="DYNAMIXEL motor ID"/>
  <arg name="center_position" default="2048" doc="Center position value (0 degrees)"/>
  <arg name="position_per_degree" default="11.378" doc="Position units per degree"/>
  <arg name="min_angle_deg" default="-180" doc="Minimum angle limit (degrees)"/>
  <arg name="max_angle_deg" default="180" doc="Maximum angle limit (degrees)"/>
  <arg name="profile_velocity" default="250" doc="Motor rotation speed"/>
  
  <!-- Person tracking specific parameters -->
  <arg name="detections_topic" default="/detected_persons" doc="Topic for person detection results"/>
  <arg name="image_width" default="640" doc="Camera image width (pixels)"/>
  <arg name="image_height" default="480" doc="Camera image height (pixels)"/>
  <arg name="horizontal_fov_deg" default="70.0" doc="Camera horizontal field of view (degrees)"/>
  <arg name="no_person_behavior" default="return_to_center" doc="Behavior when no person detected: stay|return_to_center|search"/>
  <arg name="no_detection_timeout_sec" default="1.0" doc="Timeout before no-person behavior activates (seconds)"/>
  <arg name="search_speed_deg_per_sec" default="30.0" doc="Search sweep speed (degrees/second)"/>
  <arg name="search_amplitude_deg" default="60.0" doc="Search sweep amplitude (degrees)"/>
  <arg name="control_rate_hz" default="20.0" doc="Control loop frequency (Hz)"/>
  
  <!-- Keyboard teleop specific parameters -->
  <arg name="movement_step" default="10" doc="Keyboard movement step size (degrees)"/>
  
  <!-- Load configuration parameters -->
  <rosparam file="$(find dynamixel_controller)/config/dynamixel_params.yaml" command="load"/>
  
  <!-- Mode selection info -->
  <param name="controller_mode" value="$(arg mode)"/>
  
  <!-- Keyboard Teleop Mode -->
  <group if="$(eval arg('mode') == 'keyboard')">
    <node name="keyboard_teleop" pkg="dynamixel_controller" type="keyboard_teleop.py" 
          output="screen" respawn="false">
      
      <!-- Device configuration -->
      <param name="device_name" value="$(arg device_name)"/>
      <param name="baudrate" value="$(arg baudrate)"/>
      
      <!-- Motor configuration -->
      <param name="motor_id" value="$(arg motor_id)"/>
      <param name="center_position" value="$(arg center_position)"/>
      <param name="position_per_degree" value="$(arg position_per_degree)"/>
      <param name="movement_step" value="$(arg movement_step)"/>
      <param name="min_angle_deg" value="$(arg min_angle_deg)"/>
      <param name="max_angle_deg" value="$(arg max_angle_deg)"/>
      <param name="profile_velocity" value="$(arg profile_velocity)"/>
    </node>
    
    <node pkg="rostopic" type="rostopic" name="mode_announcer" 
          args="pub -l /controller/mode std_msgs/String 'data: keyboard'" output="log"/>
  </group>
  
  <!-- Person Tracking Mode -->
  <group if="$(eval arg('mode') == 'tracking')">
    <node name="person_tracker" pkg="dynamixel_controller" type="person_tracker.py" 
          output="screen" respawn="false">
      
      <!-- Detection input -->
      <param name="detections_topic" value="$(arg detections_topic)"/>
      
      <!-- Camera parameters -->
      <param name="image_width" value="$(arg image_width)"/>
      <param name="image_height" value="$(arg image_height)"/>
      <param name="horizontal_fov_deg" value="$(arg horizontal_fov_deg)"/>
      
      <!-- Device configuration -->
      <param name="device_name" value="$(arg device_name)"/>
      <param name="baudrate" value="$(arg baudrate)"/>
      
      <!-- Motor configuration -->
      <param name="motor_id" value="$(arg motor_id)"/>
      <param name="center_position" value="$(arg center_position)"/>
      <param name="position_per_degree" value="$(arg position_per_degree)"/>
      <param name="min_angle_deg" value="$(arg min_angle_deg)"/>
      <param name="max_angle_deg" value="$(arg max_angle_deg)"/>
      <param name="profile_velocity" value="$(arg profile_velocity)"/>
      
      <!-- Tracking behavior -->
      <param name="no_person_behavior" value="$(arg no_person_behavior)"/>
      <param name="no_detection_timeout_sec" value="$(arg no_detection_timeout_sec)"/>
      <param name="search_speed_deg_per_sec" value="$(arg search_speed_deg_per_sec)"/>
      <param name="search_amplitude_deg" value="$(arg search_amplitude_deg)"/>
      <param name="control_rate_hz" value="$(arg control_rate_hz)"/>
    </node>
    
    <node pkg="rostopic" type="rostopic" name="mode_announcer" 
          args="pub -l /controller/mode std_msgs/String 'data: tracking'" output="log"/>
  </group>
  
  <!-- Optional: DYNAMIXEL Workbench Controller (for service-based control) -->
  <!-- Note: This is an alternative approach that provides /dynamixel_workbench/dynamixel_command service -->
  <arg name="use_workbench" default="false" doc="Use dynamixel_workbench_controllers instead of direct SDK"/>
  <group if="$(arg use_workbench)">
    <node name="dynamixel_workbench" pkg="dynamixel_workbench_controllers" type="dynamixel_workbench_controllers"
          output="screen" respawn="false">
      
      <!-- Device configuration -->
      <param name="device_info/device_port" value="$(arg device_name)"/>
      <param name="device_info/baud_rate" value="$(arg baudrate)"/>
      <param name="device_info/protocol_version" value="2.0"/>
      
      <!-- Motor configuration -->
      <param name="dynamixel_info/motor_id" value="$(arg motor_id)"/>
      <param name="dynamixel_info/motor_model" value="xl330-m288"/>
      
      <!-- Control table settings -->
      <param name="control_table/Operating_Mode" value="3"/>        <!-- Position Control -->
      <param name="control_table/Torque_Enable" value="1"/>         <!-- Enable torque -->
      <param name="control_table/Min_Position_Limit" value="0"/>
      <param name="control_table/Max_Position_Limit" value="4095"/>
      <param name="control_table/Profile_Velocity" value="$(arg profile_velocity)"/>
      <param name="control_table/Profile_Acceleration" value="10"/>
      <param name="control_table/Current_Limit" value="1000"/>
      <param name="control_table/Position_P_Gain" value="800"/>
      <param name="control_table/Position_I_Gain" value="0"/>
      <param name="control_table/Position_D_Gain" value="0"/>
      
      <!-- Initialize to center position on startup -->
      <param name="control_table/Goal_Position" value="$(arg center_position)"/>
    </node>
  </group>
  
  <!-- Status and monitoring -->
  <node name="controller_status" pkg="rostopic" type="rostopic" 
        args="echo /person_tracker/status" output="log" if="$(eval arg('mode') == 'tracking')"/>

</launch>