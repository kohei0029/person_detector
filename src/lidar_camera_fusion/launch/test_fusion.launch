<?xml version="1.0"?>
<launch>
  <!-- ======================================== -->
  <!-- LiDAR-Camera Fusion テスト環境の起動 -->
  <!-- ======================================== -->
  
  <!-- 1. 仮の静的TFのパブリッシュ -->
  <!-- LiDARはカメラの真上10cmにある設定 -->
  <node name="lidar_to_camera_tf" pkg="tf2_ros" type="static_transform_publisher" 
        args="0 0 0.1 0 0 0 camera_link lidar_link" />
  
  <!-- カメラのベースフレーム（オプション） -->
  <node name="camera_base_tf" pkg="tf2_ros" type="static_transform_publisher" 
        args="0 0 1.0 0 0 0 base_link camera_link" />
  
  <!-- 2. 人物検出ノードの起動 -->
  <!-- person_detectorパッケージのlaunchファイルをインクルード -->
  <include file="$(find person_detector)/launch/person_detector.launch" />
  
  <!-- 3. ダミーLiDARノードの起動 -->
  <node name="mock_lidar_publisher" pkg="lidar_camera_fusion" type="mock_lidar_publisher.py" output="screen">
    <!-- 人物の位置パラメータ（必要に応じて変更可能） -->
    <param name="person_x" value="2.0" />
    <param name="person_y" value="0.0" />
    <param name="person_z" value="0.8" />
    <param name="person_radius" value="0.3" />
    <param name="num_points" value="50" />
    <param name="publish_rate" value="10.0" />
  </node>
  
  <!-- 4. フュージョンノードの起動 -->
  <node name="lidar_camera_fusion_node" pkg="lidar_camera_fusion" type="fusion_node.py" output="screen">
    <!-- パラメータ設定 -->
    <param name="camera_frame_id" value="camera_link" />
    <param name="lidar_frame_id" value="lidar_link" />
    
    <!-- カメラ内部パラメータ -->
    <param name="camera_fx" value="525.0" />
    <param name="camera_fy" value="525.0" />
    <param name="camera_cx" value="319.5" />
    <param name="camera_cy" value="239.5" />
    <param name="camera_width" value="640" />
    <param name="camera_height" value="480" />
    
    <!-- トピック設定 -->
    <remap from="detected_persons" to="/detected_persons" />
    <remap from="mock_lidar/person_points" to="/mock_lidar/person_points" />
    <remap from="fused_persons/person_pose" to="/fused_persons/person_pose" />
  </node>
  
  <!-- ======================================== -->
  <!-- オプション：デバッグ・可視化ツール -->
  <!-- ======================================== -->
  
  <!-- TF可視化（オプション） -->
  <!-- <node name="tf_visualizer" pkg="tf2_tools" type="view_frames.py" /> -->
  
  <!-- RViz可視化（オプション） -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find lidar_camera_fusion)/config/fusion_test.rviz" />
  
  <!-- トピック監視（オプション） -->
  <!-- <node name="topic_monitor" pkg="rostopic" type="rostopic" args="echo /fused_persons/person_pose" output="screen" /> -->
  
  <!-- ======================================== -->
  <!-- 起動完了メッセージ（削除済み） -->
  <!-- ======================================== -->
  
</launch> 